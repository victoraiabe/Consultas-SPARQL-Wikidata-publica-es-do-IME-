#defaultView:BarChart
SELECT ?professor ?professorLabel (COUNT(DISTINCT ?artigo) AS ?totalArtigos)
WHERE {

  SERVICE <https://query-scholarly.wikidata.org/sparql> {
    ?artigo wdt:P195 wd:Q136708214 ;
             wdt:P50 ?professor .
  }

  ?professor wdt:P108 wd:Q10302895 .

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "pt,en".
  }
}
GROUP BY ?professor ?professorLabel
ORDER BY DESC(?totalArtigos)
LIMIT 10
