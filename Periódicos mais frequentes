#defaultView:BarChart
SELECT ?revista ?revistaLabel 
       (COUNT(DISTINCT ?artigo) AS ?totalArtigos)
WHERE {

  # Busca federada para artigos acadêmicos
  SERVICE <https://query-scholarly.wikidata.org/sparql> {
    ?artigo wdt:P195 wd:Q136708214 ;
             wdt:P1433 ?revista .
  }

  # Labels
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "pt,en".
  }

}

GROUP BY ?revista ?revistaLabel
ORDER BY DESC(?totalArtigos)
LIMIT 20
