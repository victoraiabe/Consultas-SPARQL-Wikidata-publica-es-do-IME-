#defaultView:BarChart
SELECT ?anos (SUM(?paginas) AS ?TotalPaginas) ?legenda
WHERE {
  {
    SELECT ?item (MIN(YEAR(?date)) AS ?ano) (MAX(?p) AS ?paginas)
    WHERE {
      SERVICE <https://query-scholarly.wikidata.org/sparql> {
        ?item wdt:P195 wd:Q136708214 ;
              wdt:P577 ?date ;
              wdt:P1104 ?p .
      }
    }
    GROUP BY ?item
  }

  BIND(STR(?ano) AS ?anos)
  BIND("IME-USP" AS ?legenda)
}
GROUP BY ?anos ?legenda
ORDER BY ?anos
